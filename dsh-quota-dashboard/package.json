{
  "name": "@local/dsh-quota-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness quota dashboard: per-provider quota for MiniMax, DeepSeek, GLM, and Sub2API in one cc-switch style panel",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
